{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "MicroserviceProject",
    "Audience": "MicroserviceProject",
    "SecretKey": "BuCokGizliBirAnahtarEnAz32KarakterOlmali!"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/product/{**catch-all}" },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "fixed"
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Match": { "Path": "/api/log/{**catch-all}" },
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "fixed"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5001" }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product": { "Address": "http://localhost:5002" }
        }
      },
      "log-cluster": {
        "Destinations": {
          "log": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
